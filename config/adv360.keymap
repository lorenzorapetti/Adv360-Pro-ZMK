#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        thumb_layer: thumb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            flavor = "balanced";
        };

        thumb_modifier: thumb_modifier {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_MODIFIER";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "Base";
            bindings = <
&kp EQUAL                   &kp N1     &kp N2      &kp N3    &kp N4     &kp N5  &none                                                                                                       &none      &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB                     &kp Q      &kp W       &kp E     &kp R      &kp T   &none                                                                                                       &none      &kp Y   &kp U     &kp I      &kp O     &kp P     &kp BSLH
&kp ESC                     &kp A      &kp S       &kp D     &kp F      &kp G   &none                     &kp LCTRL           &kp LALT          &kp LGUI                         &kp RCTRL  &none      &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT                   &kp Z      &kp X       &kp C     &kp V      &kp B                                                 &kp LEFT_ALT      &kp RIGHT_ALT                                          &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&thumb_modifier LGUI LC(A)  &kp GRAVE  &caps_word  &kp LEFT  &kp RIGHT          &thumb_layer 2 BACKSPACE  &thumb_layer 1 DEL  &kp LCTRL         &thumb_modifier RCTRL LG(SPACE)  &kp SPACE  &kp ENTER          &kp DOWN  &kp UP     &kp LBKT  &kp RBKT  &thumb_modifier RGUI LC(A)
            >;
        };

        number {
            bindings = <
&none  &none      &none      &none      &none       &none  &none                                       &none      &none          &none      &none    &none      &none          &none
&none  &kp RET    &kp SPACE  &kp TAB    &kp BSPC    &kp K  &none                                       &none      &kp LS(CARET)  &kp N6     &kp N8   &kp N9     &kp LS(PRCNT)  &kp N5
&none  &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHIFT  &kp G  &none  &none   &none      &none  &none      &none      &kp LS(STAR)   &kp N8     &kp N5   &kp N6     &kp FSLH       &none
&none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)   &kp J                 &none      &none                        &kp LS(PLUS)   &kp EQUAL  &kp N2   &kp N3     &kp MINUS      &none
&none  &none      &none      &none      &none              &none  &trans  &none      &none  &kp COLON  &kp EQUAL                 &kp N0     &kp DOT  &kp COMMA  &kp MINUS      &to 0
            >;
        };

        cursor {
            bindings = <
&none         &none      &none      &none          &none       &none      &none                                   &none  &none      &none        &none          &none      &none      &none
&kp CAPSLOCK  &kp RET    &kp SPACE  &kp TAB        &kp BSPC    &kp LC(X)  &none                                   &none  &kp LC(X)  &kp LS(TAB)  &kp LC(Z)      &kp LC(Y)  &kp TAB    &kp PRINTSCREEN
&sk LSHIFT    &kp LGUI   &kp LALT   &kp LCTRL      &kp LSHIFT  &kp LC(C)  &none   &none  &none      &none  &none  &none  &kp LEFT   &kp DOWN     &kp UP         &kp RIGHT  &kp LC(C)  &sk LSHIFT
&kp LC(L)     &kp LC(A)  &kp LC(Y)  &kp LC(Z)      &kp LC(F)   &kp LC(V)                 &none      &none                &kp HOME   &kp PG_DN    &kp PG_UP      &kp END    &kp LC(V)  &kp LC(L)
&none         &none      &none      &kp LC(LS(G))  &kp LC(G)              &trans  &none  &none      &none  &none  &none             &kp LC(F)    &kp LC(LS(G))  &kp LS(G)  &none      &none
            >;
        };
    };
};
